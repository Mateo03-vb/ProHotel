@model ProHotel.Modelos.Habitacion

@{
    ViewData["Title"] = "Editar Habitación";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="m-0 text-primary fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Habitación</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="idHabitacion" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="numero" class="form-label fw-semibold">Número de Habitación</label>
                            <input asp-for="numero" class="form-control" />
                            <span asp-validation-for="numero" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="piso" class="form-label fw-semibold">Piso</label>
                            <input asp-for="piso" class="form-control" type="number" />
                            <span asp-validation-for="piso" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="estado" class="form-label fw-semibold">Estado</label>
                            <select asp-for="estado" class="form-select">
                                <option value="Disponible">Disponible</option>
                                <option value="Ocupada">Ocupada</option>
                                <option value="Mantenimiento">Mantenimiento</option>
                                <option value="Limpieza">Limpieza</option>
                            </select>
                            <span asp-validation-for="estado" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="idTipoHabitacion" class="form-label fw-semibold">Tipo de Habitación</label>
                            <select asp-for="idTipoHabitacion" class="form-select" asp-items="ViewBag.TiposHabitacion">
                                <option value="">-- Seleccionar Tipo --</option>
                            </select>
                            <span asp-validation-for="idTipoHabitacion" class="text-danger"></span>
                        </div>

                        <div class="col-12 mt-4 d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver a la lista
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
