@model ProHotel.Modelos.Habitacion

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Habitacion</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="numero" class="control-label">Número de Habitación</label>
                <input asp-for="numero" class="form-control" />
                <span asp-validation-for="numero" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="piso" class="control-label">Piso</label>
                <input asp-for="piso" class="form-control" type="number" />
                <span asp-validation-for="piso" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="estado" class="control-label">Estado</label>
                <select asp-for="estado" class="form-select">
                    <option value="Disponible">Disponible</option>
                    <option value="Ocupada">Ocupada</option>
                    <option value="Mantenimiento">Mantenimiento</option>
                    <option value="Limpieza">Limpieza</option>
                </select>
                <span asp-validation-for="estado" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="idTipoHabitacion" class="control-label">ID Tipo de Habitación</label>
                <input asp-for="idTipoHabitacion" class="form-control" type="number" />
                <span asp-validation-for="idTipoHabitacion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
