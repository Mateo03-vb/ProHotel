@model IEnumerable<ProHotel.Modelos.Habitacion>

@{
    ViewData["Title"] = "Habitaciones";
}

<h1>Habitaciones</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nueva Habitación</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Número</th>
            <th>Piso</th>
            <th>Tipo de Habitación</th>
            <th>Precio Base / Noche</th>
            <th>Capacidad</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <strong>Habitación @item.numero</strong>
            </td>
            <td>
                Piso @item.piso
            </td>
            <td>
                @(item.TipoHabitacion != null ? item.TipoHabitacion.nombre : "Tipo #" + item.idTipoHabitacion)
            </td>
            <td>
                @(item.TipoHabitacion != null ? item.TipoHabitacion.precioBaseNoche.ToString("C2") : "-")
            </td>
            <td>
                @(item.TipoHabitacion != null ? item.TipoHabitacion.capacidadPersonas + " pers." : "-")
            </td>
            <td>
                <span class="badge @(item.estado?.ToLower() == "disponible" ? "bg-success" : (item.estado?.ToLower() == "ocupada" ? "bg-danger" : "bg-warning text-dark"))">
                    @item.estado
                </span>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idHabitacion" class="btn btn-sm btn-outline-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.idHabitacion" class="btn btn-sm btn-outline-info">Detalles</a>
                <a asp-action="Delete" asp-route-id="@item.idHabitacion" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
