@model ProHotel.Modelos.Servicio

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Servicio</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            Nombre del Servicio
        </dt>
        <dd class="col-sm-9">
            <strong>@Model.nombre</strong>
        </dd>

        <dt class="col-sm-3">
            Descripción
        </dt>
        <dd class="col-sm-9">
            @Model.descripcion
        </dd>

        <dt class="col-sm-3">
            Precio
        </dt>
        <dd class="col-sm-9">
            <strong>@Model.precio.ToString("C2")</strong>
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.idServicio">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
