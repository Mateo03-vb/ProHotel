@model IEnumerable<ProHotel.Modelos.Servicio>

@{
    ViewData["Title"] = "Servicios";
}

<h1>Servicios del Hotel</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Servicio</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nombre del Servicio</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <strong>@item.nombre</strong>
            </td>
            <td>
                @item.descripcion
            </td>
            <td>
                @item.precio.ToString("C2")
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idServicio" class="btn btn-sm btn-outline-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.idServicio" class="btn btn-sm btn-outline-info">Detalles</a>
                <a asp-action="Delete" asp-route-id="@item.idServicio" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
