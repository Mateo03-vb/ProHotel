@model ProHotel.Modelos.Consumo

@{
    ViewData["Title"] = "Crear Consumo";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="m-0 text-primary fw-bold"><i class="bi bi-credit-card-2-front me-2"></i>Registrar Nuevo Consumo</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="idServicio" class="form-label fw-semibold">ID Servicio</label>
                            <input asp-for="idServicio" class="form-control" type="number" placeholder="Ej: 1" />
                            <span asp-validation-for="idServicio" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="idDetalleReserva" class="form-label fw-semibold">ID Detalle Reserva</label>
                            <input asp-for="idDetalleReserva" class="form-control" type="number" placeholder="Ej: 1" />
                            <span asp-validation-for="idDetalleReserva" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="cantidad" class="form-label fw-semibold">Cantidad</label>
                            <input asp-for="cantidad" class="form-control" type="number" placeholder="Ej: 1" />
                            <span asp-validation-for="cantidad" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="precioUnitario" class="form-label fw-semibold">Precio Unitario ($)</label>
                            <input asp-for="precioUnitario" class="form-control" type="number" step="0.01" placeholder="Ej: 10.00" />
                            <span asp-validation-for="precioUnitario" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="fechaConsumo" class="form-label fw-semibold">Fecha de Consumo</label>
                            <input asp-for="fechaConsumo" class="form-control" type="date" />
                            <span asp-validation-for="fechaConsumo" class="text-danger"></span>
                        </div>

                        <div class="col-12 mt-4 d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver a la lista
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i> Guardar Consumo
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
