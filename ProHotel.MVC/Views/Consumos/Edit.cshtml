@model ProHotel.Modelos.Consumo

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Consumo</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="idConsumo" />
            <div class="form-group mb-3">
                <label asp-for="idServicio" class="control-label">ID Servicio</label>
                <input asp-for="idServicio" class="form-control" type="number" />
                <span asp-validation-for="idServicio" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="idDetalleReserva" class="control-label">ID Detalle Reserva</label>
                <input asp-for="idDetalleReserva" class="form-control" type="number" />
                <span asp-validation-for="idDetalleReserva" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="cantidad" class="control-label">Cantidad</label>
                <input asp-for="cantidad" class="form-control" type="number" />
                <span asp-validation-for="cantidad" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="precioUnitario" class="control-label">Precio Unitario</label>
                <input asp-for="precioUnitario" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="precioUnitario" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="fechaConsumo" class="control-label">Fecha de Consumo</label>
                <input asp-for="fechaConsumo" class="form-control" type="date" />
                <span asp-validation-for="fechaConsumo" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
