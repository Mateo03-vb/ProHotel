@model IEnumerable<ProHotel.Modelos.Consumo>

@{
    ViewData["Title"] = "Consumos";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="m-0 text-primary fw-bold"><i class="bi bi-credit-card me-2"></i>Gestión de Consumos</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Registrar Nuevo Consumo</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center m-4">
                <i class="bi bi-info-circle me-2"></i>No hay registros disponibles.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle shadow-sm rounded mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Servicio</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>Subtotal</th>
                            <th>Fecha Consumo</th>
                            <th>Habitación / Reserva</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td>
                                    <strong>@(item.Servicio != null ? item.Servicio.nombre : "Servicio #" + item.idServicio)</strong>
                                </td>
                                <td>
                                    @item.cantidad
                                </td>
                                <td>
                                    @item.precioUnitario.ToString("C2")
                                </td>
                                <td>
                                    <strong class="text-primary">@((item.cantidad * item.precioUnitario).ToString("C2"))</strong>
                                </td>
                                <td>
                                    @item.fechaConsumo.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @if (item.DetalleReserva?.Habitacion != null)
                                    {
                                        <span>Hab. @item.DetalleReserva.Habitacion.numero (Reserva #@item.DetalleReserva.idReserva)</span>
                                    }
                                    else
                                    {
                                        <span>Detalle #@item.idDetalleReserva</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.idConsumo" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i> Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.idConsumo" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> Detalles</a>
                                    <a asp-action="Delete" asp-route-id="@item.idConsumo" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
