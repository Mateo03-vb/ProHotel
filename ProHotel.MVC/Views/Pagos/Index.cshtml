@model IEnumerable<ProHotel.Modelos.Pago>

@{
    ViewData["Title"] = "Pagos";
}

<h1>Pagos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar Nuevo Pago</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Monto</th>
            <th>Método de Pago</th>
            <th>Fecha de Pago</th>
            <th>Referencia Transacción</th>
            <th>Reserva / Cliente</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <strong>@item.monto.ToString("C2")</strong>
            </td>
            <td>
                @item.metodoPago
            </td>
            <td>
                @item.fechaPago.ToString("dd/MM/yyyy")
            </td>
            <td>
                @(string.IsNullOrEmpty(item.referenciaTransaccion) ? "-" : item.referenciaTransaccion)
            </td>
            <td>
                <strong>#@item.idReserva</strong>
                @if (item.Reserva?.Cliente != null)
                {
                    <span> - @item.Reserva.Cliente.nombre @item.Reserva.Cliente.apellido</span>
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idPago" class="btn btn-sm btn-outline-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.idPago" class="btn btn-sm btn-outline-info">Detalles</a>
                <a asp-action="Delete" asp-route-id="@item.idPago" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
