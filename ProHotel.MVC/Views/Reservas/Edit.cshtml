@model ProHotel.Modelos.Reserva

@{
    ViewData["Title"] = "Editar Reserva";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="m-0 text-primary fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Reserva</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="idReserva" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="idCliente" class="form-label fw-semibold">Cliente</label>
                            <select asp-for="idCliente" class="form-select" asp-items="ViewBag.Clientes">
                                <option value="">-- Seleccionar Cliente --</option>
                            </select>
                            <span asp-validation-for="idCliente" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="idEmpleado" class="form-label fw-semibold">Empleado que Registra</label>
                            <select asp-for="idEmpleado" class="form-select" asp-items="ViewBag.Empleados">
                                <option value="">-- Seleccionar Empleado --</option>
                            </select>
                            <span asp-validation-for="idEmpleado" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="fechaReserva" class="form-label fw-semibold">Fecha de Reserva</label>
                            <input asp-for="fechaReserva" class="form-control" type="date" />
                            <span asp-validation-for="fechaReserva" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="fechaCheckIn" class="form-label fw-semibold">Fecha de Check-In</label>
                            <input asp-for="fechaCheckIn" class="form-control" type="date" />
                            <span asp-validation-for="fechaCheckIn" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="fechaCheckOut" class="form-label fw-semibold">Fecha de Check-Out</label>
                            <input asp-for="fechaCheckOut" class="form-control" type="date" />
                            <span asp-validation-for="fechaCheckOut" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="estado" class="form-label fw-semibold">Estado</label>
                            <select asp-for="estado" class="form-select">
                                <option value="Confirmada">Confirmada</option>
                                <option value="Pendiente">Pendiente</option>
                                <option value="Cancelada">Cancelada</option>
                                <option value="Finalizada">Finalizada</option>
                            </select>
                            <span asp-validation-for="estado" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="montoTotal" class="form-label fw-semibold">Monto Total ($)</label>
                            <input asp-for="montoTotal" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="montoTotal" class="text-danger"></span>
                        </div>

                        <div class="col-12 mt-4 d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver a la lista
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
