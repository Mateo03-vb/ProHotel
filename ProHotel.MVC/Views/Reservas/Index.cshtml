@model IEnumerable<ProHotel.Modelos.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="m-0 text-primary fw-bold"><i class="bi bi-calendar3 me-2"></i>Gestión de Reservas</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Crear Nueva Reserva</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center m-4">
                <i class="bi bi-info-circle me-2"></i>No hay registros disponibles.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle shadow-sm rounded mb-0">
                    <thead class="table-light">
                        <tr>
                            <th># Reserva</th>
                            <th>Cliente</th>
                            <th>Empleado</th>
                            <th>Fecha Reserva</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th>Estado</th>
                            <th>Monto Total</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td>
                                    <strong>#@item.idReserva</strong>
                                </td>
                                <td>
                                    @if (item.Cliente != null)
                                    {
                                        <span class="fw-semibold">@item.Cliente.nombre @item.Cliente.apellido</span>
                                        <br />
                                        <small class="text-muted"><i class="bi bi-card-text me-1"></i>Doc: @item.Cliente.numeroDocumento</small>
                                    }
                                    else
                                    {
                                        <span>Cliente #@item.idCliente</span>
                                    }
                                </td>
                                <td>
                                    @(item.Empleado != null ? item.Empleado.nombre + " " + item.Empleado.apellido : "Empleado #" + item.idEmpleado)
                                </td>
                                <td>
                                    @item.fechaReserva.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @item.fechaCheckIn.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @item.fechaCheckOut.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    <span class="badge @(item.estado?.ToLower() == "confirmada" ? "bg-success" : (item.estado?.ToLower() == "cancelada" ? "bg-danger" : "bg-primary"))">
                                        @item.estado
                                    </span>
                                </td>
                                <td>
                                    <strong class="text-primary">@item.montoTotal.ToString("C2")</strong>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.idReserva" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i> Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.idReserva" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> Detalles</a>
                                    <a asp-action="Delete" asp-route-id="@item.idReserva" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
