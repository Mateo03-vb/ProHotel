@model ProHotel.Modelos.Reserva

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Reserva</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="idCliente" class="control-label">ID Cliente</label>
                <input asp-for="idCliente" class="form-control" type="number" />
                <span asp-validation-for="idCliente" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="idEmpleado" class="control-label">ID Empleado</label>
                <input asp-for="idEmpleado" class="form-control" type="number" />
                <span asp-validation-for="idEmpleado" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="fechaReserva" class="control-label">Fecha de Reserva</label>
                <input asp-for="fechaReserva" class="form-control" type="date" />
                <span asp-validation-for="fechaReserva" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="fechaCheckIn" class="control-label">Fecha Check-In</label>
                <input asp-for="fechaCheckIn" class="form-control" type="date" />
                <span asp-validation-for="fechaCheckIn" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="fechaCheckOut" class="control-label">Fecha Check-Out</label>
                <input asp-for="fechaCheckOut" class="form-control" type="date" />
                <span asp-validation-for="fechaCheckOut" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="estado" class="control-label">Estado</label>
                <select asp-for="estado" class="form-select">
                    <option value="Confirmada">Confirmada</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Cancelada">Cancelada</option>
                    <option value="Finalizada">Finalizada</option>
                </select>
                <span asp-validation-for="estado" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="montoTotal" class="control-label">Monto Total</label>
                <input asp-for="montoTotal" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="montoTotal" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
