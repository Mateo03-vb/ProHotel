@model ProHotel.Modelos.Reserva

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>ProHotel.Modelos.Reserva</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            # Reserva
        </dt>
        <dd class="col-sm-9">
            <strong>#@Model.idReserva</strong>
        </dd>

        <dt class="col-sm-3">
            Cliente
        </dt>
        <dd class="col-sm-9">
            @if (Model.Cliente != null)
            {
                <strong>@Model.Cliente.nombre @Model.Cliente.apellido</strong>
                <span class="text-muted"> (Doc: @Model.Cliente.numeroDocumento)</span>
            }
            else
            {
                <span>Cliente #@Model.idCliente</span>
            }
        </dd>

        <dt class="col-sm-3">
            Empleado
        </dt>
        <dd class="col-sm-9">
            @(Model.Empleado != null ? Model.Empleado.nombre + " " + Model.Empleado.apellido : "Empleado #" + Model.idEmpleado)
        </dd>

        <dt class="col-sm-3">
            Fecha de Reserva
        </dt>
        <dd class="col-sm-9">
            @Model.fechaReserva.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-3">
            Check-In
        </dt>
        <dd class="col-sm-9">
            @Model.fechaCheckIn.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-3">
            Check-Out
        </dt>
        <dd class="col-sm-9">
            @Model.fechaCheckOut.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-3">
            Estado
        </dt>
        <dd class="col-sm-9">
            <span class="badge @(Model.estado?.ToLower() == "confirmada" ? "bg-success" : (Model.estado?.ToLower() == "cancelada" ? "bg-danger" : "bg-primary"))">
                @Model.estado
            </span>
        </dd>

        <dt class="col-sm-3">
            Monto Total
        </dt>
        <dd class="col-sm-9">
            <strong>@Model.montoTotal.ToString("C2")</strong>
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="idReserva" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
