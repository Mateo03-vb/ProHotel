@model IEnumerable<ProHotel.Modelos.DetalleReserva>

@{
    ViewData["Title"] = "Detalles de Reservas";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="m-0 text-primary fw-bold"><i class="bi bi-journal-text me-2"></i>Detalles de Reservas</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Crear Nuevo Detalle</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center m-4">
                <i class="bi bi-info-circle me-2"></i>No hay registros disponibles.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle shadow-sm rounded mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Reserva</th>
                            <th>Habitación</th>
                            <th>Precio Noche Pactado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td>
                                    <strong>#@item.idReserva</strong>
                                    @if (item.Reserva?.Cliente != null)
                                    {
                                        <span> - @item.Reserva.Cliente.nombre @item.Reserva.Cliente.apellido</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Habitacion != null)
                                    {
                                        <span>Hab. @item.Habitacion.numero (@item.Habitacion.TipoHabitacion?.nombre)</span>
                                    }
                                    else
                                    {
                                        <span>Habitación #@item.idHabitacion</span>
                                    }
                                </td>
                                <td>
                                    <strong class="text-success">@item.PrecioNochePactado.ToString("C2")</strong>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.IdDetalleReserva" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i> Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.IdDetalleReserva" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> Detalles</a>
                                    <a asp-action="Delete" asp-route-id="@item.IdDetalleReserva" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
