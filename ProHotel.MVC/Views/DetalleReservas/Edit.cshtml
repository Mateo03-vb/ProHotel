@model ProHotel.Modelos.DetalleReserva

@{
    ViewData["Title"] = "Editar Detalle de Reserva";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="m-0 text-primary fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Detalle de Reserva</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="IdDetalleReserva" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="idReserva" class="form-label fw-semibold">Reserva Asociada</label>
                            <select asp-for="idReserva" class="form-select" asp-items="ViewBag.Reservas">
                                <option value="">-- Seleccionar Reserva --</option>
                            </select>
                            <span asp-validation-for="idReserva" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="idHabitacion" class="form-label fw-semibold">Habitación Asignada</label>
                            <select asp-for="idHabitacion" class="form-select" asp-items="ViewBag.Habitaciones">
                                <option value="">-- Seleccionar Habitación --</option>
                            </select>
                            <span asp-validation-for="idHabitacion" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="PrecioNochePactado" class="form-label fw-semibold">Precio Noche Pactado ($)</label>
                            <input asp-for="PrecioNochePactado" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="PrecioNochePactado" class="text-danger"></span>
                        </div>

                        <div class="col-12 mt-4 d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver a la lista
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
