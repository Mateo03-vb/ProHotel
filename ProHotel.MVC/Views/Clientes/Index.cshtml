@model IEnumerable<ProHotel.Modelos.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="m-0 text-primary fw-bold"><i class="bi bi-people me-2"></i>Gestión de Clientes</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> Registrar Nuevo Cliente</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center m-4">
                <i class="bi bi-info-circle me-2"></i>No hay registros disponibles.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle shadow-sm rounded mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tipo Doc.</th>
                            <th>N° Documento</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">@item.tipoDocumento</span>
                                </td>
                                <td>
                                    <strong>@item.numeroDocumento</strong>
                                </td>
                                <td>
                                    @item.nombre
                                </td>
                                <td>
                                    @item.apellido
                                </td>
                                <td>
                                    @item.email
                                </td>
                                <td>
                                    @item.telefono
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.idCliente" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i> Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.idCliente" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> Detalles</a>
                                    <a asp-action="Delete" asp-route-id="@item.idCliente" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
