@model ProHotel.Modelos.TipoHabitacion

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>TipoHabitacion</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            Nombre del Tipo
        </dt>
        <dd class="col-sm-9">
            <strong>@Model.nombre</strong>
        </dd>

        <dt class="col-sm-3">
            Descripción
        </dt>
        <dd class="col-sm-9">
            @Model.descripcion
        </dd>

        <dt class="col-sm-3">
            Capacidad de Personas
        </dt>
        <dd class="col-sm-9">
            @Model.capacidadPersonas personas
        </dd>

        <dt class="col-sm-3">
            Precio Base por Noche
        </dt>
        <dd class="col-sm-9">
            <strong>@Model.precioBaseNoche.ToString("C2")</strong>
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.idTipoHabitacion">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
