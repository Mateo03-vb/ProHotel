@model ProHotel.Modelos.Empleado

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>ProHotel.Modelos.Empleado</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            Cédula
        </dt>
        <dd class="col-sm-9">
            <strong>@Model.cedula</strong>
        </dd>

        <dt class="col-sm-3">
            Nombre Completo
        </dt>
        <dd class="col-sm-9">
            @Model.nombre @Model.apellido
        </dd>

        <dt class="col-sm-3">
            Cargo
        </dt>
        <dd class="col-sm-9">
            @Model.cargo
        </dd>

        <dt class="col-sm-3">
            Estado
        </dt>
        <dd class="col-sm-9">
            <span class="badge @(Model.activo ? "bg-success" : "bg-danger")">
                @(Model.activo ? "Activo" : "Inactivo")
            </span>
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="idEmpleado" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
