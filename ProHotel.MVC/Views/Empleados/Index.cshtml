@model IEnumerable<ProHotel.Modelos.Empleado>

@{
    ViewData["Title"] = "Empleados";
}

<h1>Empleados</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar Nuevo Empleado</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Cédula</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Cargo</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <strong>@item.cedula</strong>
            </td>
            <td>
                @item.nombre
            </td>
            <td>
                @item.apellido
            </td>
            <td>
                @item.cargo
            </td>
            <td>
                <span class="badge @(item.activo ? "bg-success" : "bg-danger")">
                    @(item.activo ? "Activo" : "Inactivo")
                </span>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.idEmpleado" class="btn btn-sm btn-outline-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.idEmpleado" class="btn btn-sm btn-outline-info">Detalles</a>
                <a asp-action="Delete" asp-route-id="@item.idEmpleado" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
