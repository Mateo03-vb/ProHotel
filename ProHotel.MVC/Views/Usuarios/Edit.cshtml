@model ProHotel.Modelos.Usuario

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Usuario</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="idUsuario" />
            <div class="form-group mb-3">
                <label asp-for="idEmpleado" class="control-label">ID Empleado</label>
                <input asp-for="idEmpleado" class="form-control" type="number" />
                <span asp-validation-for="idEmpleado" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="username" class="control-label">Nombre de Usuario</label>
                <input asp-for="username" class="form-control" />
                <span asp-validation-for="username" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="passwordHash" class="control-label">Contraseña</label>
                <input asp-for="passwordHash" class="form-control" type="password" />
                <span asp-validation-for="passwordHash" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="rol" class="control-label">Rol</label>
                <select asp-for="rol" class="form-select">
                    <option value="Administrador">Administrador</option>
                    <option value="Recepcionista">Recepcionista</option>
                    <option value="Gerente">Gerente</option>
                    <option value="Personal">Personal</option>
                </select>
                <span asp-validation-for="rol" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="activo" class="form-check-input" type="checkbox" />
                <label asp-for="activo" class="form-check-label">Usuario Activo</label>
                <span asp-validation-for="activo" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
