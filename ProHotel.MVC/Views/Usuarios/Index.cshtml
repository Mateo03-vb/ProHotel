@model IEnumerable<ProHotel.Modelos.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="m-0 text-primary fw-bold"><i class="bi bi-people me-2"></i>Usuarios del Sistema</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Crear Nuevo Usuario</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="alert alert-info text-center m-4">
                <i class="bi bi-info-circle me-2"></i>No hay registros disponibles.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle shadow-sm rounded mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre de Usuario</th>
                            <th>Empleado Asociado</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td>
                                    <strong>@item.username</strong>
                                </td>
                                <td>
                                    @(item.Empleado != null ? item.Empleado.nombre + " " + item.Empleado.apellido + " (" + item.Empleado.cargo + ")" : "Empleado #" + item.idEmpleado)
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@item.rol</span>
                                </td>
                                <td>
                                    <span class="badge @(item.activo ? "bg-success" : "bg-danger")">
                                        @(item.activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.idUsuario" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i> Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.idUsuario" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> Detalles</a>
                                    <a asp-action="Delete" asp-route-id="@item.idUsuario" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
