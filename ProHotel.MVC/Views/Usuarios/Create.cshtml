@model ProHotel.Modelos.Usuario

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="m-0 text-primary fw-bold"><i class="bi bi-person-plus me-2"></i>Crear Nuevo Usuario</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="idEmpleado" class="form-label fw-semibold">Empleado Asociado</label>
                            <select asp-for="idEmpleado" class="form-select" asp-items="ViewBag.Empleados">
                                <option value="">-- Seleccionar Empleado --</option>
                            </select>
                            <span asp-validation-for="idEmpleado" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="username" class="form-label fw-semibold">Nombre de Usuario</label>
                            <input asp-for="username" class="form-control" placeholder="Ej: jperez" />
                            <span asp-validation-for="username" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="passwordHash" class="form-label fw-semibold">Contraseña</label>
                            <input asp-for="passwordHash" class="form-control" type="password" placeholder="Ingrese una contraseña" />
                            <span asp-validation-for="passwordHash" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="rol" class="form-label fw-semibold">Rol</label>
                            <select asp-for="rol" class="form-select">
                                <option value="Administrador">Administrador</option>
                                <option value="Recepcionista">Recepcionista</option>
                                <option value="Gerente">Gerente</option>
                                <option value="Personal">Personal</option>
                            </select>
                            <span asp-validation-for="rol" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="activo" class="form-check-input" type="checkbox" checked />
                                <label asp-for="activo" class="form-check-label fw-semibold">Usuario Activo</label>
                            </div>
                            <span asp-validation-for="activo" class="text-danger"></span>
                        </div>

                        <div class="col-12 mt-4 d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Volver a la lista
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i> Guardar Usuario
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
