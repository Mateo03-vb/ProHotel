<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProHotel.MVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProHotel.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
    @if (User.Identity.IsAuthenticated)
    {
        // ==========================================
        // MUNDO PRIVADO (USUARIO LOGUEADO)
        // Barra completa con todos los iconos de gestión
        // ==========================================
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold fs-1 text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building-check"></i> ProHotel
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house fs-3">Home</i>
                                </a>

                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="Clientes" asp-action="Index">
                                    <i class="bi bi-person fs-3">Clientes</i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="Reservas" asp-action="Index">
                                    <i class="bi bi-calendar3 fs-3">Reservas</i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="DetalleReservas" asp-action="Index">
                                    <i class="bi bi-journal-text fs-3">Detalle Reservas</i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="Consumos" asp-action="Index">
                                    <i class="bi bi-credit-card fs-3">Consumos</i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="Pagos" asp-action="Index">
                                    <i class="bi bi-cash-coin fs-3">Pagos</i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="Servicios" asp-action="Index">
                                    <i class="bi bi-bag fs-3">Servicios</i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="TipoHabitaciones" asp-action="Index">
                                    <i class="bi bi-door-open fs-3">Tipos de Habitaciones</i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="Habitaciones" asp-action="Index">
                                    <i class="bi bi-door-closed fs-3">Habitaciones</i>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="Empleados" asp-action="Index">
                                    <i class="bi bi-person-vcard fs-3">Empleados</i>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-primary" asp-area="" asp-controller="Usuarios" asp-action="Index">
                                    <i class="bi bi-person-badge fs-3">Usuarios</i>
                                </a>
                            </li>
                        </ul>
                    <!-- Cerrar Sesión a la derecha -->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-danger fw-bold" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión (@User.Identity.Name)
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    }
    else
    {
        // ==========================================
        // MUNDO PÚBLICO (VISITANTE NO LOGUEADO)
        // Barra simple con solo el logo y botón de login
        // ==========================================
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold fs-1 text-primary" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building-check"></i> ProHotel
                </a>
                <div class="d-flex">
                    <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                    </a>
                </div>
            </div>
        </nav>
    }
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ProHotel.MVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
